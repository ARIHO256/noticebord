# =============================================================================
# Bugema University NoticeBoard - Backend Environment Configuration
# =============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in all required values (marked with [REQUIRED])
# 3. NEVER commit .env to git - it contains secrets!
# 4. For production, use strong passwords and secret keys
#
# =============================================================================


# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================

# [REQUIRED] A long, random secret key for cryptographic signing
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-50-character-random-string

# Environment: local | production
DJANGO_ENV=local

# [REQUIRED for production] Comma-separated list of allowed hosts
# Examples: localhost,127.0.0.1,api.bugema.ac.ug
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Debug mode - NEVER enable in production
DJANGO_DEBUG=1


# =============================================================================
# DATABASE
# =============================================================================

# For local development (SQLite):
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# For production (PostgreSQL) - uncomment these:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=bugema_noticeboard
# DB_USER=bugema
# DB_PASSWORD=[REQUIRED] your-strong-db-password
# DB_HOST=localhost
# DB_PORT=5432


# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================

# [REQUIRED for production] Comma-separated list of allowed frontend origins
# Must match your mobile app / web frontend URLs exactly
# Examples:
#   Expo development: http://localhost:8081,http://localhost:19000
#   Production app: https://bugema-noticeboard.web.app
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19000


# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# For local development - prints emails to console:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For production - SMTP (uncomment and configure):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-specific-password
# DEFAULT_FROM_EMAIL=Bugema University <noreply@bugema.ac.ug>


# =============================================================================
# REDIS & CELERY
# =============================================================================

# Redis connection URLs
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Cache backend selector:
# - local development default is in-memory cache (safe when Redis is not running)
# - set to 1 to force Redis cache locally
USE_REDIS_CACHE=0


# =============================================================================
# FILE STORAGE (Optional - for production S3)
# =============================================================================

# AWS S3 Configuration (uncomment for production):
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=bugema-noticeboard-media
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=media.bugema.ac.ug


# =============================================================================
# PUSH NOTIFICATIONS (Expo)
# =============================================================================

# Expo push notification configuration
EXPO_ACCESS_TOKEN=your-expo-access-token


# =============================================================================
# SECURITY (Production Only)
# =============================================================================

# SSL/TLS settings - only enable behind a reverse proxy with HTTPS
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=1
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1


# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# =============================================================================
# DEVELOPMENT HELPERS
# =============================================================================

# Disable celery task eager mode for testing async behavior
# CELERY_TASK_ALWAYS_EAGER=0

# Custom API port (default: 8000)
# API_PORT=8000
