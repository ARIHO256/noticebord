# =============================================================================
# Bugema University NoticeBoard - Mobile Environment Configuration
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in the API URL for your backend
# 3. NEVER commit .env to git!
#
# For Expo, variables must be prefixed with EXPO_PUBLIC_ to be accessible
# in the bundled JavaScript code.
# =============================================================================


# =============================================================================
# API CONFIGURATION
# =============================================================================

# [REQUIRED] Backend API base URL
# Development (local network - use your computer's IP):
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# Development (localhost - for iOS simulator only):
# EXPO_PUBLIC_API_URL=http://localhost:8000

# Development (Android emulator):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Production:
# EXPO_PUBLIC_API_URL=https://api.bugema.ac.ug


# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# API port (fallback if URL doesn't include port)
EXPO_PUBLIC_API_PORT=8000

# Enable debug logging in the app
EXPO_PUBLIC_DEBUG=1

# App version (should match app.json)
EXPO_PUBLIC_APP_VERSION=0.1.0

# Environment name shown in debug UI
EXPO_PUBLIC_APP_ENV=development
