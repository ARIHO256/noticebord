{
  "expo": {
    "name": "NoticeBoard",
    "slug": "noticeboard",
    "scheme": "noticeboard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/bugema-official-logo.png",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "enabled": false
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.achiever256.noticeboard",
      "associatedDomains": ["applinks:noticeboard.bugema.ac.ug"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/bugema-official-logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.achiever256.noticeboard",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "noticeboard.bugema.ac.ug",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/bugema-official-logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "9bf15646-32c5-402e-a14b-1ccfab29242d"
      },
      "apiUrl": "https://noticeboard.bugema.ac.ug"
    },
    "plugins": [
      "expo-font",
      "expo-video",
      "expo-local-authentication"
    ]
  }
}
